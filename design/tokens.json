{
  "version": "1.0.0",
  "name": "piano-school-landing",
  "fonts": {
    "display": "Fraunces",
    "ui": "IBM Plex Sans"
  },
  "color": {
    "light": {
      "bg": "#ffffff", "fg": "#0a0a0a", "hint": "#6a6a6a",
      "card": "#f6f3ec", "border": "#e8e3d6",
      "gold": "#8a6f3a", "gold-soft": "#b8975f",
      "danger": "#c0392b", "ok": "#2e7d32"
    },
    "dark": {
      "bg": "#0a0a0a", "fg": "#f4f1e8", "hint": "#a39d8f",
      "card": "#1c1916", "border": "#2a2620",
      "gold": "#c9a861", "gold-soft": "#a8893f"
    }
  },
  "type": {
    "h1": { "font": "Fraunces", "size": 56, "weight": 500, "lh": 1.02, "ls": -0.025 },
    "h2": { "font": "IBM Plex Sans", "size": 28, "weight": 600 },
    "body": { "font": "IBM Plex Sans", "size": 16, "lh": 1.5 },
    "eyebrow": { "font": "IBM Plex Sans", "size": 11, "weight": 600, "ls": 0.18, "case": "upper", "color": "gold" }
  },
  "rules": [
    "Fraunces только в h1 (V1/V3) или h1+h2+цитатах (V2)",
    "Золото только в eyebrow, hairline под h1, section-label, активном CTA",
    "Цифры всегда tabular-nums lining-nums",
    "Никаких эмодзи в неживом тексте (исключение — направления-маркеры на кнопках)"
  ]
}
